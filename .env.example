# ─── Railway (production) ───────────────────────────────────────────────────
# DATABASE_URL      → Auto from PostgreSQL plugin (link variable to web service)
# REDIS_URL         → Auto from Redis plugin (optional)
# RAILWAY_PUBLIC_DOMAIN → Auto from Railway when public URL is enabled
#
# Set these manually on the web service:
# AUTH_SECRET         → openssl rand -base64 32
# NEXTAUTH_URL        → https://YOUR-APP.up.railway.app
# NEXT_PUBLIC_APP_URL → https://YOUR-APP.up.railway.app
# RUN_SEED=true       → One-time only, to load demo data, then remove

# ─── Local development only ─────────────────────────────────────────────────
DATABASE_URL="postgresql://cubo:cubo@localhost:5432/cubo?schema=public"

AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# Stripe (optional, Phase 2)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# AWS S3 (optional, for image uploads)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""
AWS_S3_ENDPOINT=""

# Redis (optional)
REDIS_URL="redis://localhost:6379"
